def print_test_or_info_output(test):
    maybe_print_test_input(test)

    stdout = strip_string(test.get("stdout", "")) #.rstrip().encode("utf8", errors="replace"))
    stderr = strip_string(test.get("stderr", "")) #.rstrip().encode("utf8", errors="replace"))

    # Always print all student's output if this is an 'info', or --verbose is enabled
    if not(VERBOSE or test.get("alwaysoutput", False)):
        stdout = reduce_huge_output(stdout, [])
        stderr = reduce_huge_output(stderr, [])

    if test.get("stderr", False) and test.get("stdout", False):
        output_str("--- submission output ---\n")
        output_str(u"".join(stdout))
        output_str("--- submission stderr output ---\n")
        output_str(u"".join(stderr))
        output_str("---\n\n")
    elif test.get("stderr", False) or test.get("stdout", False):
        output_str("--- submission output ---\n")
        output_str(u"".join(stdout) + u"".join(stderr))
        output_str("---\n\n")
    else:
        output_str("--- no output from submission---\n\n")

def get_explain_path(test_path):
    """Get the .explain file path for a given test script or output file."""
    return os.path.splitext(test_path)[0] + ".explain"

def get_explain_content(test_path, output_file=None):
    """Get explanation content from .explain file(s).

    Args:
        test_path: Path to the test script (e.g., test-foo.sh, prog-run.sh)
        output_file: Optional path to output file for prog tests (e.g., example.out)

    Returns:
        Tuple of (script_explain, output_explain) where each is the content string or None
    """
    script_explain = None
    output_explain = None

    # Check for script-level .explain file
    script_explain_path = get_explain_path(test_path)
    if os.path.isfile(script_explain_path):
        try:
            with open(script_explain_path, 'rb') as f:
                script_explain = toUTF8Replace(f.read()).strip()
        except IOError:
            pass

    # Check for output-specific .explain file (for prog tests)
    if output_file is not None:
        output_explain_path = get_explain_path(output_file)
        if os.path.isfile(output_explain_path):
            try:
                with open(output_explain_path, 'rb') as f:
                    output_explain = toUTF8Replace(f.read()).strip()
            except IOError:
                pass

    return (script_explain, output_explain)

def print_explain_content(test):
    """Print explanation content if present (for terminal output on failure)."""
    script_explain = test.get("script_explain")
    output_explain = test.get("output_explain")

    if script_explain or output_explain:
        output_str("--- explanation ---\n")
        if script_explain:
            output_str(script_explain + "\n")
        if output_explain:
            if script_explain:
                output_str("\n")  # Separate script and output explanations
            output_str(output_explain + "\n")
        output_str("---\n\n")

def finalize_test(test):
    """Common finalization for all test types: explain, fail tracking, store."""
    # Print explanation content on failure (terminal only)
    if not test["pass"]:
        print_explain_content(test)

    # Track if any test failed (for fail-fast)
    global anyTestFailed
    if not test["pass"]:
        anyTestFailed = True

    testStore.append(test)

# Record that a test was run, printing as appropriate
def register_returnval_test(test):
    test["pass"] = (test["returnval"] == 0)

    if test["pass"]:
        # Print pass if not quiet, or if alwaysoutput (INFO tests always show)
        if not QUIET or test.get("alwaysoutput", False):
            print("pass ✅")
    else:
        # In quiet mode, print the prefix now since we didn't print it earlier
        # (unless it's an alwaysoutput test, which already printed prefix)
        if QUIET and "prefix" in test and not test.get("alwaysoutput", False):
            output_str(test["prefix"])
        print("fail ❌")

    if not test["pass"] or test.get("alwaysoutput", False):
        print_test_or_info_output(test)

    finalize_test(test)

# Record that a test was run, printing as appropriate
def register_multival_test(test):
    test["pass"] = (test["returnval"] == 0)

    if test["pass"]:
        if not QUIET:
            print(test["trafficlight"])
    else:
        # In quiet mode, print the prefix now since we didn't print it earlier
        if QUIET and "prefix" in test:
            output_str(test["prefix"])
        print(test["trafficlight"])

    if not test["pass"] or test.get("alwaysoutput", False):
        print_test_or_info_output(test)

    finalize_test(test)
    

# Register the result of a test with a known output
def register_diff_test(test, comparefile):
    with open(comparefile, 'rb') as stream:
        comparelines = toUTF8Replace(stream.read())
    comparelines = strip_string(comparelines)
    userlines = strip_string(test["stdout"] + test["stderr"])

    userlines = reduce_huge_output(userlines, comparelines)

    test["comparelines"] = comparelines
    test["userlines"] = userlines

    # If test passed just print pass
    if comparelines == userlines:
        test["pass"] = True
        if not QUIET:
            print("pass ✅")

    # If test failed print expected & real output (& possibly extras)
    else:
        test["pass"] = False
        # In quiet mode, print the prefix now since we didn't print it earlier
        if QUIET and "prefix" in test:
            output_str(test["prefix"])
        print("fail ❌")
        # If verbose, print input to stdout
        maybe_print_test_input(test)
        # Create text for expected & real output
        textdiff = []
        if len(comparelines) > 0:
            textdiff.extend([u"--- expected output ---\n"] + comparelines)
        else:
            textdiff.extend([u"--- no output expected ---\n"])

        if len(userlines) > 0:
            textdiff.extend([u"--- submission output ---\n"] + userlines + [u"---\n"])
        else:
            textdiff.extend([u"--- no output from submission ---\n"])

        # Print to stdout
        test["textdiff"] = textdiff
        textout = u"".join(test["textdiff"])
        output_str(textout + "\n")

    # Create table for html
    test["htmldiff"] = difflib.HtmlDiff().make_table(userlines, comparelines, u"Submission", u"Reference")

    finalize_test(test)


