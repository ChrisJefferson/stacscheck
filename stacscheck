def html_escape(s):
    """Escape HTML special characters."""
    if s is None:
        return ""
    return (str(s)
        .replace('&', '&amp;')
        .replace('<', '&lt;')
        .replace('>', '&gt;')
        .replace('"', '&#34;')
        .replace("'", '&#39;'))


