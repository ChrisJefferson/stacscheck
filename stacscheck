# Given a filename of a test, get a nicer, shorter name which
# describes the test. First drop extension, then remove PARENTBASE
def nice_name(name):
    noextension = os.path.splitext(name)[0]
    dropdir = noextension[len(PARENTBASE):]
    return dropdir.lstrip("/")

# Check if one directory is contained within another
def in_directory(basedir, childdir):
    #make both absolute    
    basedir = os.path.join(os.path.realpath(basedir),'')
    childdir = os.path.join(os.path.realpath(childdir), '')
    return os.path.commonprefix([basedir, childdir]) == basedir

# Read from a stream, recording result in a record
# Caps the total amount read to ~1MB
def read_stream(outdict, name, stream):
    stream_limit = 1024*1024
    outdict[name] = bytearray()
    while True:
        try:
            chunk = stream.read(stream_limit - len(outdict[name]))
            # End of file reached
            if chunk == b'':
                return

            # Add chunk
            outdict[name].extend(chunk)

            if len(outdict[name]) == stream_limit:
                outdict[name] += b"\n ... Output truncated\n"
                # Throw away rest of stream
                while stream.read(1024) != b'':
                    pass
                return
        except IOError:
            pass


# This is an internal function, use run_program below
def run_program_popen(program, stdin, extra_env):
    env_copy = os.environ.copy()

    if extra_env is not None:
        for key in extra_env:
            env_copy[key] = extra_env[key]

    try:
        proc = subprocess.Popen(program, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, close_fds=True, shell=False,
                                cwd=SUBMISSIONBASE, env=env_copy, preexec_fn=os.setsid)

        starttime = time.time()

        retdict = dict()

        thread_err = Thread(target=read_stream, args=(retdict, "stderr", proc.stderr))
        thread_err.daemon = True
        thread_err.start()
        thread_out = Thread(target=read_stream, args=(retdict, "stdout", proc.stdout))
        thread_out.daemon = True
        thread_out.start()

        if stdin is not None:
            stdinfd = open(stdin, "rb")
            try:
                for line in stdinfd.readlines():
                    proc.stdin.write(line)
                    time.sleep(0.002)
            except IOError:
                pass
            stdinfd.close()
        # Either we have filled stdin, or we are putting nothing in it
        proc.stdin.close()

        # Install signal handler to catch Ctrl+C during test execution
        global sigint_received
        sigint_received = False
        old_handler = signal.signal(signal.SIGINT, sigint_handler)

        interrupted = False
        try:
            while (proc.poll() is None) and (time.time() - starttime < float(CONFIG['timeout'])):
                if sigint_received:
                    interrupted = True
                    break
                time.sleep(0.1)
        except KeyboardInterrupt:
            interrupted = True
        finally:
            # Restore original signal handler
            signal.signal(signal.SIGINT, old_handler)

        # Handle Ctrl+C interruption
        if interrupted and proc.poll() is None:
            # Send SIGINT to the process group (same as Ctrl+C)
            try:
                os.killpg(os.getpgid(proc.pid), signal.SIGINT)
            except (ProcessLookupError, OSError):
                pass
            # Give it a moment to handle the signal
            time.sleep(0.2)
            # If still running, terminate it
            if proc.poll() is None:
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
                    proc.terminate()
                except (ProcessLookupError, OSError):
                    pass

        timeouthit = False
        if not interrupted and (proc.poll() is None):
            output_str(f"!! {CONFIG['timeout']} second timeout reached\n")
            timeouthit = True
            os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
            proc.terminate()
            proc.kill()

        # Give 10 seconds for the output streams to finish absorbing output
        # This limit should only be reached if another forked process holds the
        # streams
        thread_err.join(10)
        thread_out.join(10)
        proc.wait()
        retdict["stderr"] = toUTF8Replace(bytes(retdict["stderr"]))
        if timeouthit:
            retdict["stderr"] += "\n... Terminating due to timeout\n"
        retdict["stdout"] = toUTF8Replace(bytes(retdict["stdout"]))

        if interrupted:
            # Print special message and dump output
            print("\n\n!! Stopping user program (Ctrl+C pressed)")
            if retdict["stdout"].strip():
                print("--- stdout ---")
                print(retdict["stdout"])
            if retdict["stderr"].strip():
                print("--- stderr ---")
                print(retdict["stderr"])
            sys.exit(130)  # Standard exit code for SIGINT


        retdict["returnval"] = proc.returncode

        return retdict
    except OSError as e:
        warn_print(f"{program[0]} is broken: {e.strerror}")
        return {"returnval": 1, "stdout": "", "stderr": ""}

# Run a program, given as a list [prog, arg1, arg2], with
# an optional file to read as stdin, and optional extra environment variables
def run_program(program, stdin, extra_env):
    with tempfile.TemporaryDirectory() as scratchdir:
        extra_env["SCRATCHDIR"] = scratchdir
        extra_env["TESTROOTDIR"] = PARENTBASE
        return run_program_popen(program, stdin, extra_env)
    
def run_bash_script(script, stdin, extra_env):
    return run_program(["bash", script], stdin, extra_env)

# Find files in 'directory' matching 'regex'
def files_in_dir_matching_regex(directory, regex):
    try:
        names = [f for f in sorted(os.listdir(directory))
                if re.match(regex, f) and not f.startswith('.')]
        files = [os.path.join(directory, f) for f in names
                if os.path.isfile(os.path.join(directory, f))]
    except OSError as e:
        warn_print(f"Error reading '{directory}': {e.strerror}")
        return []

    return files

# Accept a directory name relative to
def run_simple_script_tests(testdir, pattern, test_type, prefix_template, extra_env,
                            always_output=False):
    """Run simple script tests (build/test/info) that use register_returnval_test.

    Returns True if testing should continue, False if caller should return early.
    """
    global anyBuildTestFailed
    scripts = files_in_dir_matching_regex(testdir, pattern)

    for script in scripts:
        # Check fail-fast (not for build tests, they handle failure differently)
        if test_type != "Build" and FAILFAST and anyTestFailed:
            return False

        name = nice_name(script)
        prefix = prefix_template.format(name)

        # Print prefix (always for info, conditionally for others)
        if always_output or not QUIET:
            output_str(prefix)

        result = run_bash_script(script, None, extra_env)
        result["name"] = name
        result["path"] = script
        result["type"] = test_type
        result["prefix"] = prefix
        result["inputlines"] = ["No .in input file (search manually)."]

        if always_output:
            result["alwaysoutput"] = True

        script_explain, _ = get_explain_content(script)
        result["script_explain"] = script_explain

        register_returnval_test(result)

        # Build tests exit on failure
        if test_type == "Build" and result["returnval"] != 0:
            verbose_print(f"Exiting early due to failed {script}")
            anyBuildTestFailed = True
            return False

    return True

def run_tests_recursive(testdir):
    # First check for a build*.sh
    extra_env = {"TESTDIR" : testdir}

    # In this case run all tests
    inside_TESTBASE = in_directory(TESTBASE, testdir)

    # In this case just run build tests
    prefix_of_TESTBASE = in_directory(testdir, TESTBASE)

    if not inside_TESTBASE and not prefix_of_TESTBASE:
        return

    # BUILDSCRIPTS
    if not run_simple_script_tests(testdir, r'build.*\.sh', "Build",
                                   "* BUILD TEST - {} : ", extra_env):
        return

    if inside_TESTBASE:
        # TESTSCRIPTS
        if not run_simple_script_tests(testdir, r'test.*\.sh', "Test",
                                       "* TEST - {} : ", extra_env):
            return

        # INFOSCRIPTS
        if not run_simple_script_tests(testdir, r'info.*\.sh', "Info",
                                       "* INFO 💡 - {} : ", extra_env, always_output=True):
            return

        # MULTISCRIPTS
        multiscripts = files_in_dir_matching_regex(testdir, r'multi.*\.sh')

        for multi in multiscripts:
            if FAILFAST and anyTestFailed:
                return
            multiresult = run_bash_script(multi, None, extra_env)
            # Load explanation content for multi script (shared across all sub-tests)
            script_explain, _ = get_explain_content(multi)
            multicount = 1
            try:
                for result in json.loads(multiresult["stdout"]):
                    if FAILFAST and anyTestFailed:
                        return
                    name = f"{nice_name(multi)}-{multicount:02d}-{result['name'].replace(',', '').replace(' ', '-')}"
                    multicount = multicount + 1
                    prefix = f"* MULTI-PART-TEST - {name} : "
                    if not QUIET:
                        output_str(prefix)
                    result["name"] = name
                    result["path"] = multi
                    result["type"] = "Multi"
                    result["prefix"] = prefix

                    # State there is no fixed input file
                    result["inputlines"] = ["No .in input file (search manually)."]

                    # Add explanation content
                    result["script_explain"] = script_explain

                    register_multival_test(result)
            except Exception as e:
                warn_print(str(e))

        # PROGSCRIPTS
        progscripts = files_in_dir_matching_regex(testdir, r'prog.*\.sh')

        outtextfiles = files_in_dir_matching_regex(testdir, r'.*\.out')

        # If there isn't exactly one .out file per .sh, warn
        if (len(outtextfiles) == 0) != (len(progscripts) == 0):
            if len(outtextfiles) == 0:
                warn_print(f"Found prog*.sh without *.out files in {testdir}")
            else:
                warn_print(f"Found *.out files without prog*.sh in {testdir}")
        for progsh in progscripts:
            for out in outtextfiles:
                if FAILFAST and anyTestFailed:
                    return
                infile = out[:-4] + ".in"
                if not os.path.isfile(infile):
                    infile = None
                name = f"{nice_name(progsh)}-{os.path.basename(out)}"
                prefix = f"* COMPARISON TEST - {name} : "
                if not QUIET:
                    output_str(prefix)
                result = run_bash_script(progsh, infile, extra_env)
                result["name"] = name
                result["input"] = infile
                result["path"] = progsh
                result["type"] = "Prog"
                result["prefix"] = prefix

                # Add contents of input file to result (DOESN'T WORK UNLESS THERE'S AN .IN FILE)
                if result["input"] is not None:
                    with open(result["input"], 'rb') as stream:
                        inputlines = toUTF8Replace(stream.read())

                    inputlines = strip_string(inputlines)
                    result["inputlines"] = inputlines
                else:
                    result["inputlines"] = None

                # Load explanation content (script-level and/or output-specific)
                script_explain, output_explain = get_explain_content(progsh, out)
                result["script_explain"] = script_explain
                result["output_explain"] = output_explain

                # Add diff for html to result
                register_diff_test(result, out)

    # Check fail-fast before recursing into subdirectories
    if FAILFAST and anyTestFailed:
        return

    # Always search in subdirectories
    # Run tests for subdirectories
    try:
        subdirs = [os.path.join(testdir, d) for d in sorted(os.listdir(testdir))
                if os.path.isdir(os.path.join(testdir, d))]

        for d in subdirs:
            if FAILFAST and anyTestFailed:
                return
            run_tests_recursive(d)
    except OSError as e:
        warn_print(str(e))

def extract_to_temp(sub_found, temp_dir):
    # Support new argument
    if 'filter' in inspect.signature(sub_found.extractall).parameters:
        sub_found.extractall(path=temp_dir, filter='tar')
    else:
        sub_found.extractall(path=temp_dir)
    sub_found.close()

    # Note: this works because both tarfile and zipfile libraries have these functions. If
    # something else is added that doesn't have these functions it will need changing.

def extract_file_with_submission(archive_name, temp_dir):
    current_path = os.path.abspath(os.getcwd())
    
    # Check that the file specified with --archive exists in cwd
    if not os.path.exists(os.path.join(current_path, ARCHIVE)):
        print(f"- File not found: {archive_name}")
        sys.exit(1)
    # Make object and get list of contents
    if archive_name.endswith('.zip'):
        file_object = zipfile.ZipFile(archive_name, mode='r')
        content_list = file_object.namelist()
    elif archive_name.endswith('.tar.xz'):
        file_object = tarfile.open(name=archive_name, mode='r:xz')
        content_list = file_object.getnames()
    elif archive_name.endswith('.tar.gz') or archive_name.endswith('.tgz'):
        file_object = tarfile.open(name=archive_name, mode='r:gz')
        content_list = file_object.getnames()
    elif archive_name.endswith('.tar.bz2'):
        file_object = tarfile.open(name=archive_name, mode='r:bz2')
        content_list = file_object.getnames()
    elif archive_name.endswith('.tar'):
        file_object = tarfile.open(name=archive_name, mode='r')
        content_list = file_object.getnames()
    else:
        print(f"- File {ARCHIVE} is not a recognised type of archive (only zip and tar files are supported)")
        sys.exit(1)

    # If submission folder is inside (or looks like it), extract. Otherwise move on
    submission_name = CONFIG['srcdir'] + "/"
    foundMatch = False

    for content in content_list:
        if submission_name in content:
            foundMatch = True
            break
    if not foundMatch:
        file_object.close()
        print(f"- Couldn't find a directory called {CONFIG['srcdir']} in the archive {archive_name}")
        sys.exit(1)

    print(f"- Extracting {archive_name} to temp folder")
    extract_to_temp(file_object, temp_dir)


